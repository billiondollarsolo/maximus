# =============================================================================
# Maximus — production / self-host environment
# Copy:  cp .env.prod.example .env.prod
# Fill:  ./scripts/generate-secrets.sh --write .env.prod
# Then set DOMAIN, ACME_EMAIL, TLS_MODE, and provider keys.
# Deploy:  ./scripts/up-prod.sh
#
# Data plane (pick one):
#   DEPLOY_MODE=bundled  — Postgres + Valkey + RustFS in Compose (default)
#   DEPLOY_MODE=external — use managed/cloud DATABASE_URL, VALKEY_URL, S3_*
#                          (do not start local data services)
# See docs/deploy-external.md and deploy/helm for Kubernetes.
# =============================================================================

# bundled | external
DEPLOY_MODE=bundled
# Docker Compose profiles: "bundled" starts postgres/valkey/rustfs; empty = app only
COMPOSE_PROFILES=bundled

# --- Public hostname (required) ---
DOMAIN=chat.example.com
APP_URL=https://chat.example.com
# Let's Encrypt account email (required for HTTP-01 and recommended for DNS-01)
ACME_EMAIL=ops@example.com

# TLS_MODE selects Caddyfile + image:
#   http01     — public A/AAAA record, ports 80+443 open (default)
#   cloudflare — DNS-01 with Cloudflare API token (no open 80 needed)
#   route53    — DNS-01 with AWS Route 53 credentials
#   local      — internal CA for LAN / smoke tests
TLS_MODE=http01

# Stock image for http01/local. DNS modes: scripts/up-prod.sh builds maximus-caddy:local
CADDY_IMAGE=caddy:2.9-alpine
# Overridden by scripts/up-prod.sh for each TLS_MODE:
# CADDYFILE=./docker/Caddyfile

HTTP_PORT=80
HTTPS_PORT=443
HTTPS_UDP_PORT=443

# --- Cloudflare DNS-01 (TLS_MODE=cloudflare) ---
# Create token: Zone → DNS → Edit (include zone resources)
CLOUDFLARE_API_TOKEN=

# --- AWS Route 53 DNS-01 (TLS_MODE=route53) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional hosted zone id if plugin requires it
AWS_HOSTED_ZONE_ID=

# --- Secrets (required) — never commit real values ---
ENCRYPTION_KEY=
BETTER_AUTH_SECRET=

# --- Bundled Postgres (DEPLOY_MODE=bundled) ---
POSTGRES_USER=maximus
POSTGRES_PASSWORD=
POSTGRES_DB=maximus
# Override full URL (also used for DEPLOY_MODE=external → RDS/CloudSQL/CNPG)
# DATABASE_URL=postgres://user:pass@host:5432/maximus

# --- Bundled Valkey ---
VALKEY_PASSWORD=
# redis://:PASSWORD@valkey:6379  (bundled default) or external Memorystore/etc.
# VALKEY_URL=redis://:pass@valkey-host:6379

# --- Object storage (bundled RustFS or external S3/R2/MinIO) ---
S3_ACCESS_KEY=maximus
S3_SECRET_KEY=
S3_BUCKET=maximus-uploads
S3_REGION=us-east-1
# Bundled default: http://rustfs:9000 — override for external:
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_FORCE_PATH_STYLE=false

# --- App ---
NODE_ENV=production
COOKIE_SECURE=true
PROVIDER_MODE=live
RATE_LIMIT_FAIL_OPEN=false
RATE_LIMIT_USER_PER_MIN=60
RATE_LIMIT_ORG_PER_MIN=600
ALLOW_PRIVATE_BASE_URLS=false

# --- Platform LLM keys (optional if using org BYOK only) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Maximus <noreply@example.com>
