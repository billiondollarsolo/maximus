{
  "name": "maximus",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @maximus/web dev",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @maximus/auth exec tsx scripts/e2e-seed.ts && playwright test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "db:migrate": "pnpm --filter @maximus/db exec tsx src/migrate.ts",
    "db:studio": "pnpm --filter @maximus/db studio",
    "secrets": "./scripts/generate-secrets.sh",
    "up:dev": "./scripts/up-dev.sh",
    "up:prod": "./scripts/up-prod.sh",
    "backup": "./scripts/backup.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.9"
  }
}
