# =============================================================================
# Maximus — local development environment
# Copy to .env and fill secrets:  cp .env.example .env && ./scripts/generate-secrets.sh --write .env
# Production: use .env.prod.example → .env.prod  (see docs/deploy.md)
# =============================================================================

# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
# Optional build identity (Admin Overview + /api/health)
# APP_VERSION=0.0.0
# GIT_SHA=
# Admin overview SSE recompute interval (ms)
# OVERVIEW_SSE_INTERVAL_MS=5000
# Session / auth secret (any long random string)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# AES-256-GCM key for BYOK provider secrets (32 bytes, base64)
# Generate:  openssl rand -base64 32
ENCRYPTION_KEY=
COOKIE_SECURE=false

# Optional first-owner hints (UI bootstrap still required when DB is empty)
BOOTSTRAP_EMAIL=admin@localhost
BOOTSTRAP_PASSWORD=change-me-now

# --- Database (local compose defaults) ---
DATABASE_URL=postgres://maximus:maximus@localhost:5432/maximus
POSTGRES_USER=maximus
POSTGRES_PASSWORD=maximus
POSTGRES_DB=maximus
POSTGRES_PORT=5432

# --- Valkey (rate limits) ---
VALKEY_URL=redis://localhost:6379
VALKEY_PASSWORD=
VALKEY_PORT=6379
RATE_LIMIT_USER_PER_MIN=60
RATE_LIMIT_ORG_PER_MIN=600
RATE_LIMIT_FAIL_OPEN=false

# --- Object storage (RustFS / S3) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=maximus
S3_SECRET_KEY=maximussecret
S3_BUCKET=maximus-uploads
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- LLM providers (optional; Admin BYOK also supported) ---
PROVIDER_MODE=live
# PROVIDER_MODE=fake  # E2E only — fake adapter, not demo catalog models
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
ALLOW_PRIVATE_BASE_URLS=true

# --- Email (optional invites) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Maximus <noreply@localhost>

# --- Local compose optional proxy ---
DOMAIN=localhost
WEB_PORT=3000
HTTP_PORT=80
HTTPS_PORT=443
